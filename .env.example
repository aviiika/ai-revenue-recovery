# ---------------------------------------------------------------------------
# Names only. Never commit real values. Copy to .env and fill in locally.
# ---------------------------------------------------------------------------

# --- Application ---
APP_ENV=local                 # local | ci | demo
LOG_LEVEL=INFO
API_PORT=8000

# --- Database (matches docker-compose.yml service defaults) ---
DATABASE_URL=postgresql+psycopg://revrec:revrec@localhost:5432/revrec
# Used by the test suite; must be a DIFFERENT database from DATABASE_URL.
TEST_DATABASE_URL=postgresql+psycopg://revrec:revrec@localhost:5432/revrec_test

# --- Redis / Celery (used from Milestone 4 onward) ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Razorpay (TEST MODE ONLY -- see docs/architecture.md) ---
# Safety gate: the Razorpay adapter refuses to start unless this is exactly "test".
RAZORPAY_MODE=test
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- LLM provider (optional; system runs in deterministic degraded mode without it) ---
LLM_PROVIDER=none             # none | anthropic | openai
LLM_MODEL=
LLM_API_KEY=

# --- Demo endpoints ---
# POST /api/v1/demo/* are refused unless this is true. Keep false outside demo/local.
DEMO_ENDPOINTS_ENABLED=true
# Fixed seed so every synthetic run is byte-for-byte reproducible.
SYNTHETIC_SEED=20260902

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
